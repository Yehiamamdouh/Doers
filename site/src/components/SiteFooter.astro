---
import menu from '../data/services-menu.json';
const { lang = 'en' } = Astro.props;
const ar = lang === 'ar';
const link = (p) => (p.startsWith('*') ? p.slice(1) : p);
const L = ar ? { tag: 'دورز<br><em>بتعمل كل حاجة.</em>', what: 'خدماتنا', cairo: 'القاهرة', jeddah: 'جدة', follow: 'تابعنا', cAddr: 'شارع رسلان، مدينة نصر، المنطقة التاسعة، بلوك 23، برج 3', jAddr: 'مركز زهران، برج B، الدور 12', hours: 'الأحد–الخميس · 10:00–18:00' } : { tag: 'Doers<br><em>do it all.</em>', what: 'What we do', cairo: 'Cairo', jeddah: 'Jeddah', follow: 'Follow', cAddr: 'Raslan St, Nasr City, 9th Area, Block 23, Tower 3', jAddr: 'Zahran Building Center, Tower B, 12th Floor', hours: 'Sun–Thu · 10:00–18:00' };
---
<footer>
  <div class="wrap">
    <div class="fgrid">
      <div><p class="ftag" set:html={L.tag} /></div>
      <div><span class="label">{L.what}</span><ul>{menu.map((s) => <li><a href={link(s.eg || s.ksa)}>{ar ? s.ar : s.name}</a></li>)}</ul></div>
      <div><span class="label">{L.cairo}</span><p>{L.cAddr}</p><p dir="ltr" style="margin-top:8px"><a href="tel:+201101000255">+20 110 1000 255</a></p></div>
      <div><span class="label">{L.jeddah}</span><p>{L.jAddr}</p><p dir="ltr" style="margin-top:8px"><a href="tel:+966509881646">+966 50 988 1646</a></p></div>
      <div><span class="label">{L.follow}</span><ul><li><a href="https://www.facebook.com/DoersAdv/">Facebook</a></li><li><a href="https://www.instagram.com/doersadvertising/">Instagram</a></li><li><a href="https://www.linkedin.com/company/doers-advertising">LinkedIn</a></li><li><a href="https://vimeo.com/doersadvertising">Vimeo</a></li></ul></div>
    </div>
    <div class="fbot"><span>© Doers Advertising LTD</span><span>{L.hours}</span></div>
  </div>
</footer>
<a class="wa" href="https://wa.me/201101000255" aria-label="WhatsApp"><svg width="28" height="28" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.2z"/></svg></a>
<script is:inline>
document.documentElement.classList.add("js");
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target)}}),{threshold:.12});
document.querySelectorAll(".p-sec h2,.feat>div,.disc-row,.stack>div,.names>div,.steps li,.folio a,.g-item,.faq details,.stats-row>div,.rv").forEach((el,i)=>{el.classList.add("rv");el.style.transitionDelay=(i%6)*60+"ms";io.observe(el)});
</script>
