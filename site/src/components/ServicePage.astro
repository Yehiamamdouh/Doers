---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { loc } from '../lib/links.js';
const { p, alt = false } = Astro.props;
const ar = p.lang === 'ar';
const site = 'https://doersadv.com';
const enPath = `/${p.slug}/`;
const path = ar ? '/ar' + enPath : enPath;
const alternates = alt ? { en: enPath, ar: '/ar' + enPath } : ar ? { ar: path } : { en: path };
const L = ar
  ? { home: 'الرئيسية', crumbs: 'مسار الصفحة', wa: 'واتساب', how: 'طريقة <em>شغلنا.</em>', faq: 'أسئلة <em>وإجابات.</em>', start: 'ابدأ مشروعك' }
  : { home: 'Home', crumbs: 'Breadcrumb', wa: 'WhatsApp us', how: 'How we <em>work.</em>', faq: 'Questions, <em>answered.</em>', start: 'Start a project' };
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': site + path, url: site + path, name: p.title, description: p.desc, inLanguage: ar ? 'ar' : 'en-US', isPartOf: { '@id': `${site}/#website` }, breadcrumb: { '@id': site + path + '#breadcrumb' } },
    { '@type': 'Service', name: p.service, serviceType: p.service, areaServed: p.areas, provider: { '@id': `${site}/#organization` }, url: site + path },
    { '@type': 'BreadcrumbList', '@id': site + path + '#breadcrumb', itemListElement: [{ '@type': 'ListItem', position: 1, name: L.home, item: site + (ar ? '/ar/' : '/') }, { '@type': 'ListItem', position: 2, name: p.crumb }] },
    { '@type': 'FAQPage', mainEntity: p.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
    { '@type': 'Organization', '@id': `${site}/#organization`, name: 'Doers Advertising Agency', url: site + '/' },
  ],
};
---
<Base title={p.title} description={p.desc} path={path} lang={ar ? 'ar' : 'en'} alternates={alternates} schema={schema} styles={['/css/site.css']} ogType="article">
  <SiteHeader lang={ar ? 'ar' : 'en'} altHref={alt ? (ar ? enPath : '/ar' + enPath) : undefined} />
  <main>
    <div class="wrap">
      <nav class="crumbs label" aria-label={L.crumbs}><a href={ar ? '/ar/' : '/'}>{L.home}</a><span>/</span><span>{p.crumb}</span></nav>
      <section class="p-hero">
        <div>
          <h1 class="label eyebrow">{p.eyebrow}</h1>
          <p class="disp" set:html={p.h1} />
        </div>
        <div>
          <p>{p.lead}</p>
          <div class="cta-row">
            <a class="btn btn-o" href={loc('/contact-us/', ar ? 'ar' : 'en')}>{p.cta} <span class="arrow">↗</span></a>
            <a class="btn btn-line" href="https://wa.me/201101000255">{L.wa}</a>
          </div>
        </div>
      </section>
    </div>
    {p.mosaic_html && <div class="wrap" set:html={p.mosaic_html} />}
    <div class="wrap">
      <section class="p-sec">
        <h2 set:html={p.feat_h} />
        <div class="feat">
          {p.feats.map((f) => (
            <div class={f.length > 3 ? 'has-img' : ''}>
              {f.length > 3 && <img src={`/img/signage/${f[3]}.jpg`} alt={f[1]} loading="lazy" />}
              <span class="label">{f[0]}</span><h3>{f[1]}</h3><p>{f[2]}</p>
            </div>
          ))}
        </div>
      </section>
      <Fragment set:html={p.proof_html} />
      <section class="p-sec">
        <h2 set:html={L.how} />
        <ol class="steps">{p.steps.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}</ol>
      </section>
      <section class="p-sec two">
        <div><h2 style="margin-bottom:0" set:html={p.why_h} /></div>
        <div>{p.why.map((x) => <p>{x}</p>)}<div class="tags" style="margin-top:20px">{p.tags.map((t) => <span>{t}</span>)}</div></div>
      </section>
      <section class="p-sec faq">
        <h2 set:html={L.faq} />
        {p.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </section>
    </div>
    <section class="cta">
      <div class="wrap">
        <h2 set:html={p.cta_h} />
        <div class="row2"><p>{p.cta_p}</p><a class="btn" href={loc('/contact-us/', ar ? 'ar' : 'en')}>{L.start} <span class="arrow">↗</span></a></div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
