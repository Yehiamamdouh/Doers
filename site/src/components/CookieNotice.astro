---
// Asks once for analytics/ads cookies; the answer updates Google Consent Mode (defaults set in Base.astro).
const { lang = 'en', ksa = false } = Astro.props;
const ar = lang === 'ar';
---
<div class="ck" id="ck" role="region" aria-label={ar ? 'ملفات تعريف الارتباط' : 'Cookies'} hidden>
  <p>{ar ? (ksa ? 'نستخدم ملفات تعريف الارتباط لفهم طريقة استخدام الموقع وتحسين إعلاناتنا.' : 'بنستخدم ملفات تعريف الارتباط عشان نفهم إزاي الموقع بيتستخدم ونحسّن إعلاناتنا.') : 'We use cookies to understand how the site is used and to improve our ads.'} <a href={ar ? '/ar/privacy-policy/' : '/privacy-policy/'}>{ar ? 'سياسة الخصوصية' : 'Privacy policy'}</a></p>
  <div class="ck-row"><button class="ck-ok" type="button" data-c="yes">{ar ? 'موافق' : 'Accept'}</button><button class="ck-no" type="button" data-c="no">{ar ? 'رفض' : 'Decline'}</button></div>
</div>
<style is:global>
.ck{position:fixed;inset-inline-start:16px;bottom:16px;z-index:70;max-width:min(420px,calc(100vw - 104px));background:#141414;color:#F1EFEA;border-radius:18px;padding:18px 20px;display:grid;gap:12px;font:400 14px/1.5 "Bricolage Grotesque","Alexandria",system-ui,sans-serif;box-shadow:0 18px 40px rgba(0,0,0,.25)}
[dir=rtl] .ck{font-family:"Alexandria",system-ui,sans-serif}
.ck[hidden]{display:none}
.ck a{color:#F7A21B;text-decoration:underline}
.ck-row{display:flex;gap:8px;flex-wrap:wrap}
.ck button{border:0;border-radius:99px;padding:10px 18px;font:700 13px inherit;font-family:inherit;cursor:pointer}
.ck .ck-ok{background:#F7A21B;color:#141414}
.ck .ck-no{background:transparent;color:#F1EFEA;box-shadow:inset 0 0 0 1px rgba(241,239,234,.35)}
</style>
<script is:inline>
(function(){
  var box=document.getElementById("ck"),c=null;
  try{c=localStorage.getItem("doers-consent")}catch(e){}
  if(!c)box.hidden=false;
  box.addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b)return;
    var v=b.dataset.c,g=v==="yes"?"granted":"denied";
    try{localStorage.setItem("doers-consent",v)}catch(e){}
    if(typeof gtag==="function")gtag("consent","update",{analytics_storage:g,ad_storage:g,ad_user_data:g,ad_personalization:g});
    box.hidden=true;
  });
})();
</script>
