---
import menu from '../data/services-menu.json';
import { loc } from '../lib/links.js';
const { lang = 'en', altHref, ksa = false } = Astro.props;
const ar = lang === 'ar';
const home = ar ? '/ar/' : '/';
const link = (p) => loc(p, lang);
const L = ar
  ? { work: 'أعمالنا', services: 'الخدمات', ksa: 'السعودية', blog: 'المدونة', contact: 'تواصل', cairo: 'القاهرة', jeddah: 'جدة', start: 'ابدأ مشروعك', other: 'English' }
  : { work: 'Work', services: 'Services', ksa: 'KSA', blog: 'Blog', contact: 'Contact', cairo: 'Cairo', jeddah: 'Jeddah', start: 'Start a project', other: 'عربي' };
// Arabic names are Egyptian on Cairo pages; Saudi pages use ar_ksa (Modern Standard Arabic) where it differs.
const name = (s) => (ar ? (ksa && s.ar_ksa) || s.ar : s.name);
---
<header class="nav">
  <div class="wrap">
    <a class="logo" href={home}><img src="/img/logo.png" alt="Doers Advertising Agency" width="500" height="322"></a>
    <ul class="menu">
      <li><a href={home + '#work'}>{L.work}</a></li>
      <li class="dd"><a href={home + '#services'}>{L.services}</a>
        <div class="mega mega-1">
          {menu.map((s) => (
            <div class="mrow">
              <a class="mname" href={link(s.eg || s.ksa)}>{name(s)}</a>
              <span class="mcity">{s.eg && <a href={link(s.eg)}>{L.cairo}</a>}{s.ksa && <a href={link(s.ksa)}>{L.jeddah}</a>}</span>
            </div>
          ))}
        </div>
      </li>
      <li><a href={link('/ksa/')}>{L.ksa}</a></li>
      <li><a href={link('/blog/')}>{L.blog}</a></li>
      <li><a href={link('/contact-us/')}>{L.contact}</a></li>
    </ul>
    <div class="nav-r">
      {altHref && <a class="lang" href={altHref} hreflang={ar ? 'en' : 'ar'} lang={ar ? 'en' : 'ar'}>{L.other}</a>}
      <a class="btn btn-line" href={link('/contact-us/')}>{L.start} <span class="arrow">↗</span></a>
    </div>
  </div>
</header>
