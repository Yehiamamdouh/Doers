---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import menu from '../data/services-menu.json';
const { lang = 'en' } = Astro.props;
const ar = lang === 'ar';
const t = ar ? {
  title: 'تواصل مع دورز - وكالة إعلانات في القاهرة وجدة',
  desc: 'تواصل مع دورز لمشروعك القادم: براندنج، فعاليات ومعارض، لافتات، تسويق رقمي ومواقع. مكاتبنا في القاهرة وجدة، ونرد خلال يوم عمل.',
  crumb: 'تواصل معنا', eyebrow: 'تواصل مع دورز', h1: 'يلا نبدأ <em>مشروعك.</em>',
  lead: 'احكيلنا بتخطط لإيه، وهنرد عليك خلال يوم عمل. أو كلمنا مباشرة على واتساب.',
  name: 'الاسم', company: 'الشركة', email: 'البريد الإلكتروني', phone: 'رقم الموبايل', service: 'الخدمة', city: 'المدينة', message: 'احكيلنا عن المشروع',
  choose: 'اختار خدمة', other: 'حاجة تانية', send: 'ابعت', sending: 'بيتبعت…', ok: 'وصلتنا رسالتك. هنرد عليك خلال يوم عمل.', err: 'الرسالة ماتبعتتش. جرّب تاني أو كلمنا على واتساب.',
  cairo: 'القاهرة', jeddah: 'جدة', cairoAddr: 'شارع رسلان، مدينة نصر، المنطقة التاسعة، بلوك 23، برج 3', jeddahAddr: 'مركز زهران، برج B، الدور 12', hours: 'الأحد–الخميس · 10:00–18:00', map: 'افتح الخريطة', required: 'مطلوب',
} : {
  title: 'Contact Doers Advertising Agency | Cairo & Jeddah',
  desc: 'Talk to Doers about your next project: branding, events and exhibitions, signage, digital marketing and websites. Offices in Cairo and Jeddah; we reply within one business day.',
  crumb: 'Contact Us', eyebrow: 'Contact Doers', h1: "Let's start <em>your project.</em>",
  lead: "Tell us what you're planning and we'll reply within one business day. Or message us on WhatsApp.",
  name: 'Name', company: 'Company', email: 'Email', phone: 'Mobile number', service: 'Service', city: 'City', message: 'Tell us about the project',
  choose: 'Choose a service', other: 'Something else', send: 'Send message', sending: 'Sending…', ok: "Thanks, we've got your message. We'll reply within one business day.", err: "Your message didn't send. Try again, or message us on WhatsApp.",
  cairo: 'Cairo', jeddah: 'Jeddah', cairoAddr: 'Raslan St, Nasr City, 9th Area, Block 23, Tower 3', jeddahAddr: 'Zahran Building Center, Tower B, 12th Floor', hours: 'Sun–Thu · 10:00–18:00', map: 'Open in Maps', required: 'required',
};
const path = ar ? '/ar/contact-us/' : '/contact-us/';
const site = 'https://doersadv.com';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'ContactPage', '@id': site + path, url: site + path, name: t.title, inLanguage: ar ? 'ar' : 'en-US' },
    { '@type': 'LocalBusiness', '@id': `${site}/#cairo`, name: 'Doers Advertising Agency, Cairo', parentOrganization: { '@id': `${site}/#organization` }, telephone: '+201101000255', email: 'info@doersadv.com', address: { '@type': 'PostalAddress', streetAddress: 'Raslan St, 9th Area, Block 23, Tower 3', addressLocality: 'Nasr City, Cairo', addressCountry: 'EG' }, openingHours: 'Su-Th 10:00-18:00', url: site + '/' },
    { '@type': 'LocalBusiness', '@id': `${site}/#jeddah`, name: 'Doers Advertising Agency, Jeddah', parentOrganization: { '@id': `${site}/#organization` }, telephone: '+966509881646', address: { '@type': 'PostalAddress', streetAddress: 'Zahran Building Center, Tower B, 12th Floor', addressLocality: 'Jeddah', postalCode: '21491', addressCountry: 'SA' }, openingHours: 'Su-Th 10:00-18:00', url: site + '/ksa/' },
  ],
};
---
<Base title={t.title} description={t.desc} path={path} lang={lang} alternates={{ en: '/contact-us/', ar: '/ar/contact-us/' }} schema={schema} styles={['/css/site.css', '/css/contact.css']}>
  <SiteHeader lang={lang} altHref={ar ? '/contact-us/' : '/ar/contact-us/'} />
  <main class="wrap">
    <nav class="crumbs label" aria-label="Breadcrumb"><a href={ar ? '/ar/' : '/'}>{ar ? 'الرئيسية' : 'Home'}</a><span>/</span><span>{t.crumb}</span></nav>
    <section class="contact">
      <div>
        <h1 class="label eyebrow">{t.eyebrow}</h1>
        <p class="disp" set:html={t.h1} />
        <p class="lead">{t.lead}</p>
        <div class="offices">
          <div><span class="label">{t.cairo}</span><p>{t.cairoAddr}</p><p dir="ltr"><a href="tel:+201101000255">+20 110 1000 255</a></p><a class="map" href="https://www.google.com/maps/search/?api=1&query=Doers+Advertising+Nasr+City+Cairo" target="_blank" rel="noopener">{t.map} ↗</a></div>
          <div><span class="label">{t.jeddah}</span><p>{t.jeddahAddr}</p><p dir="ltr"><a href="tel:+966509881646">+966 50 988 1646</a></p><a class="map" href="https://www.google.com/maps/search/?api=1&query=Zahran+Building+Center+Jeddah" target="_blank" rel="noopener">{t.map} ↗</a></div>
          <div><span class="label">Email</span><p><a href="mailto:info@doersadv.com">info@doersadv.com</a></p><p>{t.hours}</p><a class="btn btn-o wa-btn" href="https://wa.me/201101000255">WhatsApp ↗</a></div>
        </div>
      </div>
      <form class="cform" id="cform" action="/contact.php" method="post" novalidate>
        <input type="hidden" name="lang" value={lang}>
        <div class="hp" aria-hidden="true"><label>Website<input type="text" name="website" id="cf-website" tabindex="-1" autocomplete="off"></label></div>
        <div class="row">
          <label for="cf-name">{t.name} <small>({t.required})</small><input id="cf-name" name="name" required autocomplete="name"></label>
          <label for="cf-company">{t.company}<input id="cf-company" name="company" autocomplete="organization"></label>
        </div>
        <div class="row">
          <label for="cf-email">{t.email} <small>({t.required})</small><input id="cf-email" name="email" type="email" required autocomplete="email"></label>
          <label for="cf-phone">{t.phone}<input id="cf-phone" name="phone" type="tel" autocomplete="tel" dir="ltr"></label>
        </div>
        <div class="row">
          <label for="cf-service">{t.service}<select id="cf-service" name="service"><option value="">{t.choose}</option>{menu.map((s) => <option>{s.name}</option>)}<option>{t.other}</option></select></label>
          <label for="cf-city">{t.city}<select id="cf-city" name="city"><option>{t.cairo}</option><option>{t.jeddah}</option><option>Riyadh</option><option>Dubai</option><option>{t.other}</option></select></label>
        </div>
        <label for="cf-message">{t.message} <small>({t.required})</small><textarea id="cf-message" name="message" rows="6" required></textarea></label>
        <button class="btn btn-o" type="submit" id="cf-send">{t.send} <span class="arrow">↗</span></button>
        <p class="status" id="cf-status" role="status" aria-live="polite"></p>
      </form>
    </section>
  </main>
  <SiteFooter lang={lang} />
  <script is:inline define:vars={{ okMsg: t.ok, errMsg: t.err, sending: t.sending, sendTxt: t.send }}>
    const f = document.getElementById('cform'), st = document.getElementById('cf-status'), btn = document.getElementById('cf-send');
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!f.checkValidity()) { f.reportValidity(); return; }
      btn.disabled = true; btn.firstChild.textContent = sending + ' ';
      try {
        const r = await fetch(f.action, { method: 'POST', body: new FormData(f), headers: { Accept: 'application/json' } });
        const j = await r.json().catch(() => ({}));
        if (!r.ok || !j.ok) throw new Error();
        f.reset(); st.textContent = okMsg; st.className = 'status ok';
        window.dataLayer && window.dataLayer.push({ event: 'generate_lead', form: 'contact' });
      } catch { st.textContent = errMsg; st.className = 'status err'; }
      finally { btn.disabled = false; btn.firstChild.textContent = sendTxt + ' '; }
    });
  </script>
</Base>
