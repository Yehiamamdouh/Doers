---
import VideoBand from '../components/VideoBand.astro';
import Base from '../layouts/Base.astro';
import schema from '../data/home-schema.json';
import { renderHome } from '../lib/home.js';
const [bodyTop, bodyRest] = renderHome('en').split('<!--VIDEOBAND-->');
---
<Base
  title="Advertising Agency in Egypt | Award-Winning, Cairo & Jeddah | Doers"
  description="Award-winning advertising agency in Egypt, TechBehemoths 2022 winner in Advertising and Branding. Branding, events, booths, digital and outdoor."
  path="/"
  lang="en"
  alternates={{ en: '/', ar: '/ar/' }}
  ogImage="https://doersadv.com/img/og-default.jpg"
  schema={schema}
  styles={['/css/home.css']}
>
  <Fragment set:html={bodyTop} />
  <VideoBand id="booth-build" lang="en" />
  <Fragment set:html={bodyRest} />
  <script is:inline src="/js/home.js" defer></script>
</Base>
