---
// Every English page that isn't the homepage or contact: new service pages, pages carried over from the old site, and blog posts.
import ServicePage from '../components/ServicePage.astro';
import LegacyPage from '../components/LegacyPage.astro';
import BlogPost from '../components/BlogPost.astro';
import pages from '../data/service-pages.json';
import pagesAr from '../data/service-pages.ar.json';
import legacy from '../data/legacy-pages.json';
import { postsIn, postSlug } from '../lib/posts.js';

export async function getStaticPaths() {
  const arPaths = new Set(legacy.filter((l) => l.lang === 'ar').map((l) => l.path.slice(3)));
  const [en, ar] = await Promise.all([postsIn('en'), postsIn('ar')]);
  const arSlugs = new Set(ar.map(postSlug));
  return [
    ...pages.map((p) => ({ params: { slug: p.slug }, props: { kind: 'service', p, alt: pagesAr.some((x) => x.slug === p.slug) } })),
    ...legacy.filter((l) => l.lang === 'en').map((l) => ({ params: { slug: l.path.slice(1, -1) }, props: { kind: 'legacy', p: l, alt: arPaths.has(l.path) } })),
    ...en.map((post, i) => ({ params: { slug: postSlug(post) }, props: { kind: 'post', post, alt: arSlugs.has(postSlug(post)), more: en.filter((_, j) => j !== i).slice(Math.max(0, i - 1), Math.max(0, i - 1) + 3) } })),
  ];
}
const { kind, p, post, alt, more } = Astro.props;
---
{kind === 'service' && <ServicePage p={p} alt={alt} />}
{kind === 'legacy' && <LegacyPage p={p} alt={alt} />}
{kind === 'post' && <BlogPost post={post} alt={alt} more={more} />}
