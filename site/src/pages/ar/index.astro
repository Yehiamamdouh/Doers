---
import VideoBand from '../../components/VideoBand.astro';
import Base from '../../layouts/Base.astro';
import schema from '../../data/home-schema.json';
import { renderHome } from '../../lib/home.js';
import faqs from '../../data/faqs.json';
const [bodyTop, bodyRest] = renderHome('ar').split('<!--VIDEOBAND-->');
const arSchema = JSON.parse(JSON.stringify(schema));
for (const node of arSchema['@graph']) {
  if (node['@type'] === 'WebPage') {
    node['@id'] = node.url = 'https://doersadv.com/ar/';
    node.name = 'شركة دعاية وإعلان في مصر والسعودية | وكالة إعلانات حاصلة على جوائز | دورز';
    node.inLanguage = 'ar';
    node.description = 'دورز شركة دعاية وإعلان في مصر والسعودية حاصلة على جائزتين من TechBehemoths في الإعلان والبراندنج: براندنج، وإيفنتات، وأجنحة معارض، وتسويق رقمي، وإعلانات طرق.';
  }
}
---
<Base
  title="شركة دعاية وإعلان في مصر والسعودية | وكالة إعلانات حاصلة على جوائز | دورز"
  description="دورز شركة دعاية وإعلان في مصر والسعودية حاصلة على جائزتين من TechBehemoths في الإعلان والبراندنج: براندنج، وإيفنتات، وأجنحة معارض، وتسويق رقمي، وإعلانات طرق."
  path="/ar/"
  lang="ar"
  alternates={{ en: '/', ar: '/ar/' }}
  ogImage="https://doersadv.com/img/og-default.jpg"
  schema={{ ...arSchema, '@graph': [...arSchema['@graph'], { '@type': 'FAQPage', mainEntity: faqs['/'].ar.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }] }}
  styles={['/css/home.css']}
>
  <Fragment set:html={bodyTop} />
  <VideoBand id="booth-build" lang="ar" />
  <Fragment set:html={bodyRest} />
  <script is:inline src="/js/home.js" defer></script>
</Base>
