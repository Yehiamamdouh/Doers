# doersadv.com on Namecheap (Apache/LiteSpeed). Deployed with the site.
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# One canonical host: https://doersadv.com (staging keeps its own host)
RewriteCond %{HTTP_HOST} ^www\.doersadv\.com$ [NC]
RewriteRule ^ https://doersadv.com%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Every page lives at a URL ending in a slash, as on the old site.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[a-z0-9]{2,5}$ [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [L,R=301]

# ---- Redirects carried over from the old site (English and Arabic) ----
RewriteRule ^(ar/)?best-advertising-agency/$ /$1 [L,R=301]
RewriteRule ^(ar/)?branding/$ /$1branding-agency-egypt/ [L,R=301]
RewriteRule ^(ar/)?media/$ /$1media-production-egypt/ [L,R=301]
RewriteRule ^(ar/)?event-management/$ /$1ksa/event-management-agency-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?(ksa/)?event-managementbtl/$ /$1ksa/event-management-agency-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?(ksa/)?digital-marketing/$ /$1ksa/digital-marketing-agency-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?(ksa/)?ooh-3/$ /$1ksa/ooh-outdoor-agency-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?ksa/branding/$ /$1ksa/branding-agency-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?ksa/seo/$ /$1ksa/seo-agency-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?ksa/booth-production/$ /$1ksa/booth-production-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?ksa/radio-advertising-ksa/$ /$1ksa/radio-advertising-agencies-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?ksa/tv-advertising-ksa-riyadh/$ /$1ksa/tv-advertising-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?radio-advertising/$ /$1ksa/radio-advertising-agencies-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?website-development-company/$ /$1ksa/website-development-company-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?Ksa/(.*)$ /$1ksa/$2 [L,R=301]
RewriteRule ^(ar/)?author/ /$1 [L,R=301]

# ---- WordPress archives the new site doesn't have ----
RewriteRule ^(ar/)?category/ /$1blog/ [L,R=301]
RewriteRule ^(ar/)?blog/page/[0-9]+/$ /$1blog/ [L,R=301]
RewriteRule ^(ar/)?(comments/)?feed/$ /$1blog/ [L,R=301]
RewriteRule ^(.+/)feed/$ /$1 [L,R=301]
RewriteRule ^(.+/)amp/$ /$1 [L,R=301]
RewriteRule ^(sitemap_index|page-sitemap|post-sitemap)\.xml$ /sitemap-index.xml [L,R=301]
# ---- BEGIN untranslated Arabic pages (scripts/build_legacy.py) ----
