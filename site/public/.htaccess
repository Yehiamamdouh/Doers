# doersadv.com on Namecheap (Apache/LiteSpeed). Deployed with the site.
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# One canonical host: https://doersadv.com (staging keeps its own host)
RewriteCond %{HTTP_HOST} ^www\.doersadv\.com$ [NC]
RewriteRule ^ https://doersadv.com%{REQUEST_URI} [L,R=301]
# Behind Cloudflare the origin can see plain HTTP even when the visitor is on HTTPS.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP:CF-Visitor} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Every page lives at a URL ending in a slash, as on the old site.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[a-z0-9]{2,5}$ [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [L,R=301]

# ---- Redirects carried over from the old site (English and Arabic) ----
RewriteRule ^(ar/)?best-advertising-agency/$ /$1 [L,R=301]
RewriteRule ^(ar/)?branding/$ /$1branding-agency-egypt/ [L,R=301]
RewriteRule ^(ar/)?media/$ /$1media-production-egypt/ [L,R=301]
RewriteRule ^(ar/)?event-management/$ /$1ksa/event-management-agency-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?(ksa/)?event-managementbtl/$ /$1ksa/event-management-agency-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?(ksa/)?digital-marketing/$ /$1ksa/digital-marketing-agency-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?(ksa/)?ooh-3/$ /$1ksa/ooh-outdoor-agency-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?ksa/branding/$ /$1ksa/branding-agency-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?ksa/seo/$ /$1ksa/seo-agency-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?ksa/booth-production/$ /$1ksa/booth-production-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?ksa/radio-advertising-ksa/$ /$1ksa/radio-advertising-agencies-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?ksa/tv-advertising-ksa-riyadh/$ /$1ksa/tv-advertising-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?radio-advertising/$ /$1ksa/radio-advertising-agencies-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?website-development-company/$ /$1ksa/website-development-company-in-jeddah/ [L,R=301]
RewriteRule ^(ar/)?Ksa/(.*)$ /$1ksa/$2 [L,R=301]
RewriteRule ^(ar/)?author/ /$1 [L,R=301]

# ---- WordPress archives the new site doesn't have ----
RewriteRule ^(ar/)?category/ /$1blog/ [L,R=301]
RewriteRule ^(ar/)?blog/page/[0-9]+/$ /$1blog/ [L,R=301]
RewriteRule ^(ar/)?(comments/)?feed/$ /$1blog/ [L,R=301]
RewriteRule ^(.+/)feed/$ /$1 [L,R=301]
RewriteRule ^(.+/)amp/$ /$1 [L,R=301]
RewriteRule ^(sitemap_index|page-sitemap|post-sitemap)\.xml$ /sitemap-index.xml [L,R=301]
# ---- BEGIN untranslated Arabic pages (scripts/build_legacy.py) ----

# ---- END untranslated Arabic pages ----
</IfModule>

# ---- Speed: compression and caching ----
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
AddType font/woff2 .woff2
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType video/mp4 "access plus 1 year"
ExpiresByType video/webm "access plus 1 year"
</IfModule>
# Pages: browsers always revalidate; Cloudflare may keep them an hour (s-maxage) and serves them as long as
# the Cache Rule's Edge TTL respects these headers. Only real pages of the site carry them, so a redirect or
# security check added by the server (e.g. Imunify360) is never kept at the edge.
<IfModule mod_headers.c>
<FilesMatch "\.html$">
Header set Cache-Control "public, max-age=0, s-maxage=3600, must-revalidate"
</FilesMatch>
</IfModule>

# ---- Block hidden files, backups and config (nothing like this should ever be served) ----
<FilesMatch "(^\.|\.(bak|sql|log|ini|sh|env|config|dist)$|^(composer|package)(-lock)?\.json$)">
  Require all denied
</FilesMatch>

# ---- Security headers ----
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
</IfModule>
